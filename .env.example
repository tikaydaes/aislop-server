# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=
PUBLIC_ORIGIN=https://aislop.tikaydaes.dev
HOST_PORT=8470
# Reverse proxies whose X-Forwarded-For is believed (addresses or CIDRs):
# the Docker bridge the host proxy connects from, plus the edge nodes.
TRUSTED_PROXIES=172.16.0.0/12
# Exact redirect URI of the browser extension. Firefox derives it from the
# add-on ID; this is the one for invidioslop@tikaydaes.
OAUTH_REDIRECT_URIS=https://5b9c47313cf074d23260c031c3c59ebcffc94cef.extensions.allizom.org/
# One-time secret: the first signed-in user to open /admin/claim?token=...
# becomes the administrator. Remove it afterwards.
ADMIN_TOKEN=
